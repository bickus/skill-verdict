#!/bin/sh
set -eu
archive=/skills.7z

extract() {
  path=${1%/}
  dir=$2
  [ -n "${SKILL_BENCH_PASSWORD:-}" ] || { echo "bench-image: SKILL_BENCH_PASSWORD is not set" >&2; exit 2; }
  mkdir -p "$dir"
  7z x -bso0 -bsp0 -bse1 -p"$SKILL_BENCH_PASSWORD" -o"$dir" "$archive" "$path/*" -r
  [ -f "$dir/$path/SKILL.md" ] || { echo "bench-image: $path not found in archive" >&2; exit 2; }
  find "$dir/$path" -type f -name _meta.json -delete
}

scan() {
  path=${1%/}
  shift
  extract "$path" /tmp/bench
  exec skill-verdict scan "$@" "/tmp/bench/$path"
}

command=${1:-}
[ $# -gt 0 ] && shift
case $command in
  extract) extract "$@" ;;
  scan) scan "$@" ;;
  *) echo "bench-image: unknown command \"$command\"" >&2; exit 2 ;;
esac
