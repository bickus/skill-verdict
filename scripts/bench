#!/bin/sh
set -u
cd "$(dirname "$0")/.." || exit 2
image=localhost/skill-verdict-bench
binary=bin/linux-amd64/skill-verdict
config=${XDG_CONFIG_HOME:-$HOME/.config}/skill-verdict/config.json
dataset=${SKILL_BENCH_DATASET:-}
usage='usage:
  scripts/bench build                     build the image
  scripts/bench ls [path]                 list what the archive holds under a path
  scripts/bench scan [scan flags] <path>  scan one skill inside the container

SKILL_BENCH_DATASET names the directory holding clawhub-skills.7z and index.txt.gz.
SKILL_BENCH_PASSWORD opens the archive. Skills are under skills/<owner>/<slug>.
'
setting() {
  [ -f "$config" ] && sed -n "s/.*\"$1\": *\"\([^\"]*\)\".*/\1/p" "$config"
}
need_dataset() {
  [ -n "$dataset" ] && [ -f "$dataset/clawhub-skills.7z" ] && [ -f "$dataset/index.txt.gz" ] && return 0
  echo "SKILL_BENCH_DATASET must name a directory holding clawhub-skills.7z and index.txt.gz" >&2
  exit 2
}
build() {
  exec podman build --network=host -t "$image" -f scripts/bench.Containerfile scripts
}
list() {
  path=${1:-skills}
  zcat "$dataset/index.txt.gz" | sed -n "s|^${path%/}/||p" | sed -e 's|/.*||' -e '/^$/d' | sort -u
}
run() {
  set -- "$image" "$@"
  set -- --volume "$dataset/clawhub-skills.7z:/skills.7z:ro" --env SKILL_BENCH_PASSWORD "$@"
  [ -x "$binary" ] && set -- --volume "$PWD/$binary:/usr/local/bin/skill-verdict:ro" "$@"
  if [ -f "$config" ]; then
    set -- --env XDG_CONFIG_HOME=/cfg --volume "$config:/cfg/skill-verdict/config.json:ro" "$@"
  fi
  key_file=$(setting keyFile)
  if [ -n "$key_file" ] && [ -f "$key_file" ]; then
    set -- --volume "$key_file:$key_file:ro" "$@"
  fi
  for name in $(setting keyEnv) $(setting githubTokenEnv); do
    [ -n "${name:-}" ] && eval "[ -n \"\${$name:-}\" ]" && set -- --env "$name" "$@"
  done
  exec podman run --rm --cap-drop=all --security-opt=no-new-privileges --read-only \
    --tmpfs '/tmp:rw,size=512m' --userns=keep-id --http-proxy=false "$@"
}
case "${1:-}" in
  build) build ;;
  ls) shift; need_dataset; list "$@" ;;
  scan)
    shift
    [ $# -ge 1 ] || { printf '%s' "$usage" >&2; exit 2; }
    need_dataset
    [ -n "${SKILL_BENCH_PASSWORD:-}" ] || { echo "SKILL_BENCH_PASSWORD is not set" >&2; exit 2; }
    [ -x "$binary" ] || { echo "$binary is missing, run scripts/check first" >&2; exit 2; }
    n=$#
    i=1
    while [ "$i" -lt "$n" ]; do
      set -- "$@" "$1"
      shift
      i=$((i + 1))
    done
    run bench-image scan "$@"
    ;;
  *) printf '%s' "$usage" >&2; exit 2 ;;
esac
