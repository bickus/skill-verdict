#!/bin/sh
if grep -Eiq '^Co-Authored-By:.*(claude|anthropic)|^Claude-Session:|claude\.ai/code/session' "$1"; then
  echo "commit rejected: AI co-author trailer or session link" >&2
  exit 1
fi
if ! grep -Eq '^Signed-off-by: .+ <.+@.+>$' "$1"; then
  echo "commit rejected: no Signed-off-by line, use git commit -s" >&2
  exit 1
fi
