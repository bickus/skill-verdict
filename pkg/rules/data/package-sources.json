{
 "rules": [
  {
   "id": "PACKAGE-SOURCE-ADDED",
   "category": "supply-chain",
   "severity": "critical",
   "title": "Package source added to the system",
   "description": "Skills usually do repeated work, and the user adds a package source only once. A new repository, registry, tap or channel changes every later install on the system. A source nobody knows is not to be trusted.",
   "kind": "heuristic",
   "layer": "static",
   "scope": "any",
   "patterns": [
    "(?i)\\b(?:add-apt|apt-add)-repository\\b",
    "(?i)/etc/apt/sources\\.list\\b",
    "(?i)\\bdeb(?:-src)?\\s+(?:\\[[^\\]\\n]*\\]\\s+)?(?:https?|ftp|file|tor\\+https?):/",
    "(?m)^[ \\t]*URIs:\\s*\\S",
    "(?i)/etc/(?:yum\\.repos\\.d|zypp/repos\\.d|distro\\.repos\\.d)\\b",
    "(?i)(?:--add-repo\\b|\\bconfig-manager\\s+addrepo\\b)",
    "(?i)\\b(?:dnf|yum)\\s+(?:-\\S+\\s+)*copr\\s+enable\\b",
    "(?i)\\bzypper\\s+(?:-\\S+\\s+)*(?:addrepo|ar)\\b",
    "(?i)/etc/pacman\\.conf\\b",
    "(?i)/etc/apk/repositories\\b",
    "(?i)\\bflatpak\\s+(?:--?\\S+\\s+)*remote-add\\b",
    "(?i)\\beselect\\s+repository\\s+(?:add|enable)\\b",
    "(?i)\\bnix-channel\\s+--add\\b",
    "(?i)\\b(?:extra-)?(?:trusted-)?substituters\\s*=",
    "(?i)\\bcachix\\s+use\\b",
    "(?i)\\b(?:npm|pnpm|yarn|bun)\\s+(?:config\\s+)?set\\s+(?:--?\\S+\\s+)*(?:@[\\w.-]+:)?registry\\b",
    "(?i)\\bnpmRegistryServer\\b",
    "(?m)(?:^|[ \\t\"'])(?:@[\\w.-]+:)?registry=[\"']?https?://",
    "(?i)\\bpip[\\d.]*\\s+config\\s+(?:--?[\\w-]+\\s+)*set\\s+[\\w-]*\\.(?:extra-index-url|index-url|find-links)\\b",
    "(?im)(?:^|[ \\t\"']|\\\\n)(?:extra-)?index-url\\s*=\\s*[\"']?https?://",
    "(?im)^[ \\t]*\\[\\[?tool\\.(?:uv\\.index|poetry\\.source|pdm\\.source)\\]\\]?",
    "(?i)\\bpoetry\\s+source\\s+add\\b",
    "(?i)\\bgem\\s+sources?\\s+(?:--add|-a)\\b",
    "(?i)\\bbundle\\s+config\\s+(?:set\\s+)?(?:--(?:global|local)\\s+)?mirror\\.",
    "(?m)^[ \\t]*\\[(?:registries|source)\\.[\\w.\"-]+\\]",
    "(?i)\\breplace-with\\s*=",
    "(?i)\\bgo\\s+env\\s+-w\\s+[^\\n]*\\bGOPROXY\\s*=",
    "(?i)\\b(?:conda|mamba|micromamba)\\s+config\\s+(?:--?[\\w-]+\\s+)*?(?:--)?(?:add|append|prepend|set)\\s+(?:channels|channel_alias|custom_channels|default_channels)\\b",
    "(?i)(?:>>?|\\btee\\b(?:\\s+-a)?)\\s*['\"]?\\S*\\.(?:condarc|mambarc)\\b",
    "(?i)\\b(?:dotnet\\s+nuget\\s+add\\s+source|nuget(?:\\.exe)?\\s+sources?\\s+add)\\b",
    "(?i)<(?:packageSources|mirrorOf)>",
    "(?i)\\bcomposer\\s+config\\s+(?:-g\\s+|--global\\s+)?repo(?:sitories)?\\.",
    "(?i)\\bhelm\\s+repo\\s+add\\b",
    "(?i)(?:\\bregistry-mirrors[\"']?\\s*:|--registry-mirror\\b)",
    "(?i)\\b(?:registries\\.conf|unqualified-search-registries)\\b",
    "(?i)(?:\\bregistry\\.mirrors\\b|/etc/containerd/certs\\.d\\b)",
    "(?im)\\bbrew\\s+trust\\s+(?:--tap\\s+)?[\\w.-]+/[\\w.-]+(?:[\\s\"'`;&|)]|$)",
    "(?m)^[ \\t]*tap\\s+[\"'][^\"'\\n]+[\"']\\s*,\\s*trusted:\\s*true\\b",
    "(?i)\\bHOMEBREW_NO_REQUIRE_TAP_TRUST\\b",
    "(?i)\\bmacports/sources\\.conf\\b",
    "(?i)\\b(?:winget\\s+source\\s+add|Add-WinGetSource)\\b",
    "(?i)\\bchoco(?:latey)?\\s+sources?\\s+add\\b",
    "(?i)\\bscoop\\s+bucket\\s+add\\b",
    "(?i)\\bRegister-(?:PSRepository|PSResourceRepository|PackageSource)\\b",
    "(?i)(?:\\bsetx(?:\\s+/m)?\\s+|SetEnvironmentVariable\\(\\s*['\"]|\\bset\\s+(?-i:-[a-zA-Z]*U[a-zA-Z]*)\\s+)(?:NPM_CONFIG_(?:@[\\w.-]+:)?REGISTRY|YARN_NPM_REGISTRY_SERVER|PIP_(?:EXTRA_)?INDEX_URL|UV_(?:EXTRA_|DEFAULT_)?INDEX(?:_URL)?|GOPROXY|HOMEBREW_(?:BOTTLE_DOMAIN|API_DOMAIN|BREW_GIT_REMOTE|CORE_GIT_REMOTE)|CARGO_REGISTRIES_\\w+|CONDA_CHANNELS)\\b",
    "(?im)\\b(?:NPM_CONFIG_(?:@[\\w.-]+:)?REGISTRY|YARN_NPM_REGISTRY_SERVER|PIP_(?:EXTRA_)?INDEX_URL|UV_(?:EXTRA_|DEFAULT_)?INDEX(?:_URL)?|GOPROXY|HOMEBREW_(?:BOTTLE_DOMAIN|API_DOMAIN|BREW_GIT_REMOTE|CORE_GIT_REMOTE)|CARGO_REGISTRIES_\\w+|CONDA_CHANNELS)\\s*=[^\\n]*(?:>>?|\\btee\\b(?:\\s+-a)?)\\s*['\"]?\\S*(?:profile|rc|environment)['\"]?(?:\\s|$)"
   ],
   "judge": {"downgrade": true, "downgradeFloor": "medium", "instructions": "Lower or dismiss when the source belongs to the OS vendor or to the vendor of the package the skill installs, and the skill needs that package. A source nobody knows keeps the severity."},
   "enabled": true
  },
  {
   "id": "PACKAGE-OTHER-REGISTRY",
   "category": "supply-chain",
   "severity": "high",
   "title": "Package installed from another registry",
   "description": "An install command takes a package from a registry other than the default one. Unable to trust such installation if there is a well-known and popular package with the same name in the default registry. False-positive if there is no such.",
   "kind": "heuristic",
   "layer": "static",
   "scope": "any",
   "patterns": [
    "(?i)\\b(?:npm|pnpm|yarn|bun|npx)\\s+(?:[^\\n]*\\s)?--registry[= ]\\s*[\"']?https?://",
    "(?i)\\b(?:pip[\\d.]*|pipx|uv|uvx)\\s+(?:[^\\n]*\\s)?(?:-i|--index-url|--extra-index-url|--index|--default-index|-f|--find-links)[= ]\\s*[\"']?(?:https?|file)://",
    "(?i)\\b(?:NPM_CONFIG_REGISTRY|YARN_NPM_REGISTRY_SERVER|PIP_(?:EXTRA_)?INDEX_URL|PIP_FIND_LINKS|UV_(?:EXTRA_|DEFAULT_)?INDEX(?:_URL)?|UV_FIND_LINKS)=[\"']?(?:https?|file)://[^\\n]*\\b(?:npm|pnpm|yarn|bun|npx|pip[\\d.]*|pipx|uv|uvx)\\s"
   ],
   "judge": {"downgrade": true, "instructions": ""},
   "enabled": true
  },
  {
   "id": "PACKAGE-PROTECTION-OFF",
   "category": "supply-chain",
   "severity": "critical",
   "title": "Install protection turned off",
   "description": "The skill turns off a package manager's install script blocking or its minimum release age, in a command or in a project file. Unless this is a false positive, do not trust the skill - packages with disabled protection should not be installed by scripts.",
   "kind": "heuristic",
   "layer": "static",
   "scope": "any",
   "patterns": [
    "(?i)\\bignore-scripts\\s*[= ]\\s*[\"']?false\\b",
    "(?i)--no-ignore-scripts\\b",
    "(?i)\\bnpm_config_(?:ignore_scripts\\s*=\\s*[\"']?false\\b|min_release_age\\s*=\\s*[\"']?0\\b)",
    "(?i)\\bmin-release-age\\s*[= ]\\s*[\"']?0\\b",
    "(?i)\\bmin-release-age-exclude\\b",
    "(?i)\\bnpm\\s+rebuild\\b",
    "(?i)\\bdangerously-?allow-?all-?builds\\b",
    "(?i)\\b(?:allowBuilds|onlyBuiltDependencies|only-built-dependencies)\\b",
    "(?i)\\bpnpm\\s+approve-builds\\b",
    "(?i)\\bminimum-?release-?age\\s*[:= ]\\s*[\"']?0\\b",
    "(?i)\\bminimum-?release-?age-?excludes?\\b",
    "(?i)\\benableScripts\\s*[:= ]\\s*[\"']?true\\b",
    "(?i)\\bnpmMinimalAgeGate\\s*[:= ]\\s*[\"']?0\\b",
    "(?i)\\btrustedDependencies\\b",
    "(?i)\\bbun\\s+pm\\s+trust\\b",
    "(?i)--allow-scripts\\b",
    "(?i)\\ballowScripts\\b",
    "(?i)\\ballow-plugins\\s*[\"']?\\s*[:= ]\\s*[\"']?true\\b",
    "(?is)\\ballow-plugins[\"']?\\s*:\\s*\\{[^}]*\\btrue\\b"
   ],
   "judge": {"downgrade": true, "instructions": "Decide only whether the protection is turned off. A comment or README explaining why does not make it a false positive."},
   "enabled": true
  },
  {
   "id": "PACKAGE-SOURCE-ADDED-HIDDEN",
   "category": "supply-chain",
   "severity": "critical",
   "title": "Package source added out of sight",
   "description": "The skill adds a package repository, registry, tap or channel out of sight. The command comes from joined text, decoded data or a downloaded file. Some skills only describe the step in words. A skill very rarely has a valid reason to add a source.",
   "kind": "llm",
   "layer": "discovery",
   "scope": "any",
   "judge": {"downgrade": true, "downgradeFloor": "medium", "instructions": ""},
   "enabled": true
  },
  {
   "id": "PACKAGE-PROTECTION-OFF-HIDDEN",
   "category": "supply-chain",
   "severity": "critical",
   "title": "Install protection turned off out of sight",
   "description": "The skill turns off install script blocking or the minimum release age out of sight. The setting comes from joined text, decoded data or a downloaded file, or the skill only describes the step in words. Unless this is a false positive, do not trust the skill - packages with disabled protection should not be installed by scripts.",
   "kind": "llm",
   "layer": "discovery",
   "scope": "any",
   "judge": {"downgrade": true, "downgradeFloor": "low", "instructions": ""},
   "enabled": true
  }
 ]
}
