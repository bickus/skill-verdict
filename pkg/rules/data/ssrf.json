 "rules": [
  {
   "id": "CLOUD-METADATA-READ",
   "category": "ssrf",
   "severity": "high",
   "title": "Cloud metadata endpoint",
   "description": "Code addresses a cloud instance metadata endpoint, which returns temporary credentials.",
   "kind": "heuristic",
   "layer": "static",
   "scope": "any",
   "patterns": [
    "(?i)169\\.254\\.169\\.254",
    "(?i)metadata\\.google\\.internal",
    "(?i)100\\.100\\.100\\.200",
    "(?i)fd00:ec2::254",
    "(?i)(?:read|fetch|get|query)\\s+(?:the\\s+)?(?:instance\\s+)?metadata\\s+(?:service|endpoint|server)"
   ],
   "judge": {"downgrade": true, "downgradeFloor": "low", "instructions": ""},
   "enabled": true
  }
 ]
}
